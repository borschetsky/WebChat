// Template for appsettings.Secrets.json, which is gitignored and holds real credentials.
//
//   1. Copy this file to appsettings.Secrets.json (same directory).
//   2. Fill in the values from Cloudflare: R2 -> Manage API Tokens -> Account API token,
//      permission "Object Read & Write" scoped to the bucket. AccountId is the subdomain of
//      the S3 endpoint shown on that page.
//   3. Never commit the result.
//
// Program.cs loads it optionally and ahead of the environment-variable provider, so a
// deployed instance configured with R2__AccountId, R2__AccessKeyId and R2__SecretAccessKey
// still wins if the file ever ends up in an image.
//
// With any of these missing, avatars fall back to local disk (wwwroot/images) - see
// Startup.AddAvatarStorage - so the app runs without this file.
{
  "R2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": ""
  }
}
