{
  // This file is committed, so it holds no credentials. The connection string and
  // JWTSecretKey are supplied per environment:
  //
  //   Visual Studio / dotnet run  appsettings.Development.json + launchSettings.json
  //   docker compose              .env in the solution directory (see .env.example)
  //   deployed                    platform environment variables
  //
  // ASP.NET Core maps environment variables onto these keys using __ as the section
  // separator, so ConnectionStrings__DefaultConnection and R2__AccessKeyId need no
  // translation step. Outside Development, Startup fails at boot when either is missing
  // rather than starting up misconfigured.
  //
  // Timestamps are stored as `timestamp with time zone` and must be written as UTC - see the
  // note on BaseEntity. Npgsql throws rather than guessing when handed a local DateTime.
  "https_port": 443,

  // Code-first bootstrap. On startup the app creates the database if missing and applies
  // pending migrations. Set AutoMigrate to false to manage schema with `dotnet ef` instead.
  "Database": {
    "AutoMigrate": true,
    "MigrateRetryCount": 10,
    "MigrateRetryDelaySeconds": 5
  },

  // Turn on only when the app runs behind a TLS-terminating proxy that overwrites
  // X-Forwarded-*: App Platform, a load balancer, an ingress controller. Enabling it when
  // the app is directly reachable lets any caller claim an arbitrary scheme and client IP.
  // In production: ForwardedHeaders__Enabled=true.
  "ForwardedHeaders": {
    "Enabled": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Origins allowed to call the API with credentials. Overridable per environment,
  // e.g. Cors__AllowedOrigins__0 in docker-compose.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://localhost:3000", "https://localhost:8081" ]
  },

  // Avatar storage. With no credentials present the app writes to wwwroot/images instead,
  // so this section can be left as-is for local work.
  //
  // AccountId, AccessKeyId and SecretAccessKey are credentials and must NOT be added here.
  // Supply them in appsettings.Secrets.json when running from Visual Studio, in .env under
  // docker compose, or as R2__AccountId / R2__AccessKeyId / R2__SecretAccessKey environment
  // variables when deployed.
  "R2": {
    "Bucket": "webchat-avatars",
    "UrlLifetimeMinutes": 15
  },

  // Uploads are re-encoded and downscaled before storage, so what lands in the bucket is
  // never the uploader's original bytes. MaxDimension 256 covers the 34-40px the client
  // renders avatars at, even on high-DPI screens.
  "Avatars": {
    "MaxUploadBytes": 5242880,
    "MaxDimension": 256,
    "MaxSourceMegapixels": 50,
    "JpegQuality": 82
  },

  // JWTSecretKey is deliberately absent - see the note at the top of this file. Lifespan is
  // not a secret: one week, in seconds.
  "JWTLifespan": 604800
}
