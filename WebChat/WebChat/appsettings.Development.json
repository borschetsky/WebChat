{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  // Where the Vite dev server lives. docker-compose overrides this with http://react-app:3000.
  "SpaDevServerUrl": "http://localhost:3000",

  // Throwaway development values, so a fresh clone runs with no setup. They live here rather
  // than in appsettings.json because this file is loaded only when
  // ASPNETCORE_ENVIRONMENT=Development: a deployed instance therefore inherits nothing, and
  // Startup.ValidateRequiredConfiguration stops it at boot when the real values are absent.
  // A shared default in appsettings.json would instead let a misconfigured production
  // instance start and quietly sign tokens with a key that is public on GitHub.
  //
  // Points at a Postgres on the host. launchSettings.json overrides it for the Visual Studio
  // profiles, and docker compose supplies its own built from .env.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=WebChat;Username=webchat;Password=webchat"
  },

  // Development only, and public by definition. Any deployment must supply JWTSecretKey as
  // an environment variable - see WebChat/.env.example.
  "JWTSecretKey": "development-only-signing-key-not-for-any-deployed-environment"
}
