# Client build settings. Copy to .env.development.local (git-ignored) and fill in.
# None of these are secrets - client and tenant ids are visible in every token - but they
# differ per environment, so they are not committed with real values.

# API base when it lives on another origin. Trailing slash required. Default: same origin.
# VITE_API_URL=https://localhost:8081/

# Password sign-in forms. Set to false together with the server's Auth__Local__Enabled=false.
# VITE_AUTH_LOCAL=true

# External sign-in (Microsoft Entra External ID). Leave VITE_ENTRA_CLIENT_ID unset for a
# password-only build - MSAL is then never downloaded.
# VITE_ENTRA_CLIENT_ID=<webchat-spa application (client) id>
# VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/v2.0
# VITE_ENTRA_API_SCOPE=api://<webchat-api application (client) id>/chat.access
# VITE_ENTRA_LABEL=Microsoft
