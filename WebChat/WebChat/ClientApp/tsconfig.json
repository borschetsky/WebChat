{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* Vite transpiles; tsc is only ever used for checking. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,

    /* .jsx and .tsx coexist while the migration is in progress. checkJs stays off so
       untyped files do not fail the build before they are converted. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* TypeScript 7 removed baseUrl; paths must be relative to this file. */
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
