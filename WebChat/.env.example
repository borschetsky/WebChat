# Template for WebChat/.env, which is gitignored and holds real values.
#
#     cp .env.example .env      # then fill it in
#     docker compose up --build
#
# docker compose loads .env automatically from this directory. Every variable below is
# referenced in docker-compose.yml as ${NAME:?...}, so a missing one stops the command with
# a message naming it rather than silently substituting an empty string.
#
# Nothing here is read at image build time. The values are injected into the running
# container as environment variables, which ASP.NET Core's configuration provider maps onto
# config keys using __ as the section separator (R2__AccessKeyId -> R2:AccessKeyId). That is
# also why no placeholder substitution step is needed anywhere.
#
# Running from Visual Studio instead? That path does not read this file - put the R2
# credentials in appsettings.Secrets.json (see appsettings.Secrets.example.json), and the
# rest come from appsettings.Development.json and launchSettings.json.

# Postgres. Used both to initialise the database container and to build the API's
# connection string, so the two cannot drift apart. Any non-empty value works locally.
POSTGRES_PASSWORD=

# Signing key for the hand-rolled JWTs. Any sufficiently long random string; changing it
# invalidates every token already issued. Generate one with:
#     openssl rand -base64 48
JWT_SECRET_KEY=

# Password for the ASP.NET developer certificate exported to ~/.aspnet/https/aspnetapp.pfx:
#     dotnet dev-certs https -ep "$env:USERPROFILE\.aspnet\https\aspnetapp.pfx" -p <value>
# Local development only - a deployed instance terminates TLS at the platform.
CERT_PASSWORD=

# Cloudflare R2, from R2 -> Manage API Tokens -> Account API token, permission
# "Object Read & Write" scoped to the bucket. ACCOUNT_ID is the subdomain of the S3 endpoint
# shown on that page.
#
# Leave all three blank to store avatars on local disk instead: Startup.AddAvatarStorage
# falls back when any is missing, so the app still runs. That fallback is fine locally and
# wrong in production, where the container filesystem does not survive a deploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Outbound mail, via Brevo's SMTP relay. Leave blank to have the app log the message instead
# of sending it - the confirmation link appears in the log, so registration works offline and
# a clone needs no Brevo account.
#
# Three different identities, which is the easiest thing to get wrong here:
#   EMAIL_SMTP_USER     the dedicated SMTP login Brevo generates, shown under SMTP & API ->
#                       SMTP. It looks like b46927001@smtp-brevo.com. NOT your account email,
#                       which fails to authenticate.
#   EMAIL_SMTP_KEY      an SMTP key generated on that same page. Not the account password.
#   EMAIL_FROM_ADDRESS  a sender verified under Senders, Domains & Dedicated IPs -> Senders.
#                       An unverified sender is accepted by the relay and then silently
#                       dropped by some recipients, Gmail in particular.
EMAIL_SMTP_USER=
EMAIL_SMTP_KEY=
EMAIL_FROM_ADDRESS=
