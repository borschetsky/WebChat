root = true

# Deliberately no [*.cs] section. Visual Studio and Rider read .editorconfig for C#
# formatting and analyzer severities, and the .NET side builds clean at 0 warnings —
# adding C# rules here would risk new warnings nobody asked for.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
